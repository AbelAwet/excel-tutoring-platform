# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database — MongoDB Atlas (recommended)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/excel-tutoring?retryWrites=true&w=majority&appName=<AppName>
# Local MongoDB (alternative for development only):
# MONGODB_URI=mongodb://localhost:27017/excel-tutoring

# JWT Secrets — CHANGE THESE to long random strings in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Frontend URL
FRONTEND_URL=http://localhost:5173
# Optional: for mobile access during development
# MOBILE_FRONTEND_URL=http://192.168.x.x:5173

# Email Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=EXCEL Tutoring <noreply@exceltutoring.com>

# Cloudinary (for file uploads — avatars, documents, payment proofs)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OTP Configuration
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# File Upload Limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Payment
# No payment gateway required — admin manually approves payments via the dashboard.
# Students submit proof of payment (bank transfer screenshot, etc.) and admin approves.
